<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard_fragment">

    <fragment
        android:id="@+id/nav_dashboard_fragment"
        android:name="com.example.nexus.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/nav_voice"
        android:name="com.example.nexus.ui.features.VoiceCommandFragment"
        android:label="Voice Command"
        tools:layout="@layout/fragment_voice_command" />

    <fragment
        android:id="@+id/nav_camera"
        android:name="com.example.nexus.ui.features.LiveCameraFragment"
        android:label="Live Camera"
        tools:layout="@layout/fragment_live_camera" />

    <fragment
        android:id="@+id/nav_alerts"
        android:name="com.example.nexus.ui.features.AlertHistoryFragment"
        android:label="Alert History"
        tools:layout="@layout/fragment_alert_history" />

    <fragment
        android:id="@+id/nav_logs"
        android:name="com.example.nexus.ui.features.ActivityLogsFragment"
        android:label="Activity Logs"
        tools:layout="@layout/fragment_activity_logs" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.nexus.ui.settings.SettingsFragment"
