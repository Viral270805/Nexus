<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard_fragment"> <!-- This tells it to load your dashboard first -->

    <!-- Dashboard (Home) Fragment -->
    <fragment
        android:id="@+id/nav_dashboard_fragment"
        android:name="com.example.nexus.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <!-- Profile Fragment -->
    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.nexus.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" /> <!-- TYPO WAS HERE -->

    <!-- Settings Fragment -->
    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.nexus.ui.profile.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <!-- ALL YOUR FEATURE FRAGMENTS -->
    <fragment
        android:id="@+id/nav_voice"
        android:name="com.example.nexus.ui.features.VoiceFragment"
        android:label="Voice Command"
        tools:layout="@layout/fragment_feature_voice" />
    <fragment
        android:id="@+id/nav_appliance"
        android:name="com.example.nexus.ui.features.ApplianceFragment"
        android:label="Appliance Control"
        tools:layout="@layout/fragment_feature_appliance" />
    <fragment
        android:id="@+id/nav_automation"
        android:name="com.example.nexus.ui.features.AutomationFragment"
        android:label="Automation"
        tools:layout="@layout/fragment_feature_automation" />
    <fragment
        android:id="@+id/nav_camera"
        android:name="com.example.nexus.ui.features.CameraFragment"
        android:label="Live Camera"
        tools:layout="@layout/fragment_feature_camera" />
    <fragment
        android:id="@+id/nav_security"
        android:name="com.example.nexus.ui.features.SecurityFragment"
        android:label="Security Alerts"
        tools:layout="@layout/fragment_feature_security" />
    <fragment
        android:id="@+id/nav_logs"
        android:name="com.example.nexus.ui.features.LogsFragment"
        android:label="Logs"
        tools:layout="@layout/fragment_feature_logs" />

</navigation>