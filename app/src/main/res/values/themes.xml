<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Nexus" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/primary_text</item>
        <item name="colorOnPrimary">@color/background_black</item>
        <item name="colorSecondary">@color/secondary_text</item>
        <item name="android:colorBackground">@color/background_black</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/primary_text</item>
        <item name="android:statusBarColor">@color/background_black</item>
        <item name="android:navigationBarColor">@color/background_black</item>
    </style>

    <style name="Theme.Nexus.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Nexus.Splash" parent="Theme.Material3.Dark">
        <item name="android:windowBackground">@color/background_black</item>
        <item name="android:statusBarColor">@color/background_black</item>
        <item name="android:navigationBarColor">@color/background_black</item>
    </style>
</resources>